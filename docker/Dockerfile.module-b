FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    make \
    gcc \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir poetry==2.4.0

COPY pyproject.toml poetry.lock* README.md /app/
COPY Makefile /app/
COPY module_b_resource_allocation /app/module_b_resource_allocation
COPY schema_contracts /app/schema_contracts
COPY data /app/data

RUN poetry config virtualenvs.create false && \
    poetry install --only main

EXPOSE 8000

CMD ["poetry", "run", "python", "-m", "uvicorn", \
     "module_b_resource_allocation.api.app:app", \
     "--host=0.0.0.0", "--port=8000"]
