# ─── Reproducibility ────────────────────────────────────────────────────────
RANDOM_SEED=42

# ─── MLflow ─────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=./mlflow/mlruns
MLFLOW_EXPERIMENT_NAME_A=module_a_segmentation

# ─── DVC remote (S3-compatible; leave blank for local-only dev) ──────────────
DVC_REMOTE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Module A ───────────────────────────────────────────────────────────────
# Override generation sample size for dev runs (default is in generation.yaml)
# MODULE_A_SAMPLE_SIZE=100000
